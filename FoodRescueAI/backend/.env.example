# ==========================================
# FoodRescue AI - Backend Environment Config
# ==========================================

# Core Authentication & SQLite Database (Active Local Defaults)
JWT_SECRET=FoodRescue-Dev-Secret-Change-Later
DATABASE_URL=sqlite:///./foodrescue.db

# Optional External Cloud Database (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/foodrescue_db

# Google Gemini AI Engine (Defaults to gemini-3.8-flash if omitted)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash

# Optional Geospatial Maps SDK (Mapbox / Google Maps)
# MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
# GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Optional Driver SMS & Notification Gateway (Twilio)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Optional Automated Email Notifications (Standard SMTP: Gmail, SendGrid, Mailgun, Brevo, AWS SES)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=notifications@foodrescue.ai
# SMTP_PASSWORD=your_smtp_app_password_or_token
# SMTP_FROM_EMAIL=notifications@foodrescue.ai
# SMTP_USE_TLS=true

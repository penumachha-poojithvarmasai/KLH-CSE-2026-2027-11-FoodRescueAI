# ==========================================
# FoodRescue AI - Full Stack Environment Config
# ==========================================

# Frontend API Endpoint (Default: FastAPI Backend, or set to Spring Cloud Gateway Port 8080)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1

# Backend Authentication & Security
JWT_SECRET=FoodRescue-Dev-Secret-Change-Later
DATABASE_URL=sqlite:///./foodrescue.db

# Google Gemini AI (Configured in backend/.env)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash

# Service Ports:
# React Frontend:       5173
# FastAPI Core Backend: 8000
# Spring Cloud Gateway: 8080
# Eureka Registry:      8761
# Food Surplus Service: 8082
# Matching Service:     8084
# Logistics Service:    8085
